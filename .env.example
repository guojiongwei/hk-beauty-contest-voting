# ============================================================
# Docker 部署环境变量模板
# 复制为 .env 后按实际环境修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# 应用对外端口（宿主机端口 -> 容器 3000）
APP_PORT=3000

# 基础镜像：国内服务器可改为镜像站，避免拉取 Docker Hub 超时
# 例如：docker.m.daocloud.io/library/ruby:3.2.2-slim
RUBY_IMAGE=ruby:3.2.2-slim

# ------------------------- 外部 MySQL -------------------------
# 生产库名固定为 hk_beauty_contest_voting_production
# 若 MySQL 运行在宿主机，可填 host.docker.internal
DB_HOST=192.168.1.100
DB_PORT=3306
DB_USERNAME=hk_beauty_contest_voting
# 生产环境密码读取的是这个变量名，注意不是 DB_PASSWORD
HK_BEAUTY_CONTEST_VOTING_DATABASE_PASSWORD=change-me

# ------------------------- 外部 Redis -------------------------
REDIS_URL=redis://192.168.1.100:6379/0

# ------------------------- 应用密钥 -------------------------
# 可用 bin/rails secret 生成；留空时容器会生成临时值，重启后已签发的 Token 会全部失效
SECRET_KEY_BASE=
JWT_SECRET=

# ------------------------- 运行参数 -------------------------
# 没有 HTTPS 时保持 false；由 Nginx 终止 SSL 后可改为 true
FORCE_SSL=false
# 演示环境返回验证码明文，方便页面直接展示；正式上线请设为 false
SMS_DEBUG_MODE=true
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
